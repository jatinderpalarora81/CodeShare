{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "hooks/audit-logger/audit-log.sh",
        "cwd": ".",
        "env": { "AUDIT_EVENT": "session_start" },
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "hooks/audit-logger/audit-log.sh",
        "cwd": ".",
        "env": { "AUDIT_EVENT": "tool_use", "GUARD_SPLUNK_READONLY": "true" },
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "hooks/audit-logger/audit-log.sh",
        "cwd": ".",
        "env": { "AUDIT_EVENT": "session_end" },
        "timeoutSec": 10
      }
    ]
  }
}
